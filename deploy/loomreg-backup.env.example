# /etc/loomreg-backup.env — read by loom-backup.sh and loom-restore-test.sh.
# 0640 root:loomreg. It names a destination and may hold nothing secret, but the rclone
# config it points at does.

# Where dumps are kept on this box before shipping, and how long they are kept here.
BACKUP_DIR=/var/backups/loomreg
BACKUP_KEEP_DAYS=30

# WHERE THE BACKUP ACTUALLY GOES. Unset, the script still runs and still keeps local
# dumps, and still tells you every night that a copy on the same disk is not a backup.
#
# Two forms:
#   rclone:<remote>:<bucket>/<path>   any rclone remote — Cloudflare R2, S3, B2
#   <user>@<host>:/<path>             rsync over ssh to another machine
#
# For R2, which is the natural one here since the zone is already on Cloudflare:
#   rclone config            # new remote, type s3, provider Cloudflare
#   BACKUP_DESTINATION=rclone:r2:loom-backups
#
# BACKUP_DESTINATION=

# Acknowledges that there is deliberately no off-box copy. Without it, the backup starts
# FAILING once the registry has published versions, rather than warning into a log.
# BACKUP_LOCAL_ONLY=yes

# The database to dump. Only change this if the registry's own name changed.
BACKUP_DATABASE=loom
