# /etc/loomreg.env — install 0640 root:loomreg. It holds the database password and the
# GitHub client secret, and systemd reads it as root before dropping to the service user.

# Required. Unix socket rather than TCP, so the password is not a thing that exists.
LOOM_DATABASE_URL=postgres:///loom?host=/var/run/postgresql

# Under StateDirectory=loomreg, which is what makes the blob backup one rsync.
LOOM_BLOB_ROOT=/var/lib/loomreg/blobs

# Loopback only: cloudflared is the only thing that should reach this, and a registry
# listening on 0.0.0.0 behind a tunnel is one anybody who finds the IP can publish to.
#
# 8090 rather than the 8080 in the docs: portfolio.service already holds 127.0.0.1:8080 on
# this box. Two services binding one port is not a conflict either of them reports — the
# second simply fails to start, and systemd restarts it forever.
LOOM_ADDRESS=127.0.0.1:8090

# All three or none — enforced at startup, because a half-configured sign-in fails at the
# callback, which is after somebody has already been sent to GitHub.
#
# The public URL, with no trailing slash. It is what the OAuth callback is built from, so
# it has to match the tunnel hostname and the GitHub app's callback URL exactly.
LOOM_BASE_URL=https://packages.example.com
LOOM_GITHUB_CLIENT_ID=
LOOM_GITHUB_CLIENT_SECRET=

# Optional. Set it and /metrics wants "Authorization: Bearer <this>"; leave it unset and
# the endpoint is open, which is defensible: it carries no package names and no secrets.
LOOM_METRICS_TOKEN=
